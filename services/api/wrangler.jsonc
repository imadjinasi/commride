{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "commride-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-18",

  // New Durable Object class lifecycle uses Cloudflare's declarative exports
  // model; the namespace is provisioned from the ActiveRideRoom export.
  "durable_objects": {
    "bindings": [
      {
        "name": "ACTIVE_RIDE_ROOM",
        "class_name": "ActiveRideRoom"
      }
    ]
  },
  "exports": {
    "ActiveRideRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },

  "vars": {
    "LOCATION_SAMPLE_RETENTION_DAYS": "30"
  },

  "triggers": {
    "crons": ["17 3 * * *", "*/15 * * * *"]
  }

  // D1 is intentionally not configured until the real pilot resource exists.
  // Do not invent or commit a database ID.
  //
  // D1 example after provisioning:
  // "d1_databases": [
  //   {
  //     "binding": "DB",
  //     "database_name": "commride-pilot",
  //     "database_id": "<real-database-id>"
  //   }
  // ]
  //
  // Provider credentials remain deployment secrets. Never put Firebase
  // service-account private keys or Google Maps server keys in this file.
}
